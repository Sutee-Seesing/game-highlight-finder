# Approved, non-secret environment overrides.
# Copy to .env only if your shell/tool loads dotenv files; the application does
# not automatically load .env.
GHF_DATA_DIR=C:\path\to\game-highlight-data
GHF_FFMPEG_PATH=C:\path\to\ffmpeg.exe
GHF_FFPROBE_PATH=C:\path\to\ffprobe.exe
GHF_LOG_LEVEL=INFO
GHF_MONTHLY_BUDGET_THB=100.00
GHF_BUDGET_TIMEZONE=Asia/Bangkok

# Plaintext API keys belong in .env; never commit the plaintext .env file.
# GEMINI_API_KEY is preferred. If it is absent, the default Gemini transport
# deterministically uses the lowest non-empty GEMINI_API_KEY1..N value.
# GEMINI_API_KEY=
# GEMINI_API_KEY1=
